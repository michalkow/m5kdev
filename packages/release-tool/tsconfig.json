{
  "extends": "@m5kdev/config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "esModuleInterop": true,
    "noEmit": true,
    "incremental": false,
    "composite": false,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
