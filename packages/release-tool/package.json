{
  "name": "m5kdev-release-tool",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "check-types": "tsc --noEmit",
    "test": "jest -c jest.config.ts",
    "record": "tsx src/cli.ts record",
    "judge": "tsx src/cli.ts judge",
