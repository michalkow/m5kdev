    "write-changeset": "tsx src/cli.ts write-changeset"
  },
  "dependencies": {
    "semver": "catalog:"
  },
  "devDependencies": {
    "@m5kdev/config": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
