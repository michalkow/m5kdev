{
  "extends": "@m5kdev/config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "esModuleInterop": true,
    "importHelpers": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "outDir": "dist",
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "exclude": ["node_modules", "dist", "tsdown.config.ts"],
  "include": ["src/**/*.ts"]
}
