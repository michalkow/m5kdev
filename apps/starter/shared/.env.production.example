# Copy to .env.production and fill in values. This file is not copied into the
# image (.dockerignore excludes .env*). app:deploy forwards every key as a Fly
# build secret; app:secrets imports the same file as runtime secrets.

# Database (Fly volume at /app/data)
DATABASE_URL=file:/app/data/local.db

# Redis — set as a Fly runtime secret (do not bake into the image)
REDIS_URL=

# Auth
BETTER_AUTH_SECRET=

# Public URLs (baked into the webapp at image build)
VITE_APP_NAME=M5 Starter
VITE_APP_URL=
VITE_SERVER_URL=
VITE_ENABLE_WAITLIST=false

# Optional
RESEND_API_KEY=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
