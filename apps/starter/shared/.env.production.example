# Production Deployment environment. Copy to .env.production and fill in values.
# This file is not copied into the image (.dockerignore excludes .env*).
# The deploy workflow writes it from the `APP_ENV_FILE` secret of the GitHub
# `production` environment. app:deploy:production forwards every key as a Fly build
# secret; app:secrets:production imports the same file as runtime secrets.

# Deployment environment
APP_ENV=production
APP_SLUG=starter-app

# PostgreSQL: runtime transaction pool and direct migration/admin connection
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_SCHEMA=app
DATABASE_DISPOSABLE=false
MASTRA_DATABASE_SCHEMA=mastra
VECTOR_DATABASE_SCHEMA=vectors

# Redis — set as a Fly runtime secret (do not bake into the image)
REDIS_URL=

# Auth
BETTER_AUTH_SECRET=

# Public URLs (baked into the webapp at image build)
VITE_APP_NAME=M5 Starter
VITE_APP_URL=
VITE_SERVER_URL=
VITE_DOCS_URL=https://starter-app-docs.fly.dev
VITE_ENABLE_WAITLIST=false

# Optional
RESEND_API_KEY=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
