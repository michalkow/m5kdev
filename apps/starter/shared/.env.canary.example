# Canary Deployment environment. Copy to .env.canary and fill in values.
# This file is not copied into the image (.dockerignore excludes .env*).
# The deploy workflow writes it from the `APP_ENV_FILE` secret of the GitHub
# `canary` environment. app:deploy:canary forwards every key as a Fly build
# secret; app:secrets:canary imports the same file as runtime secrets.

# Deployment environment
APP_ENV=canary
APP_SLUG=starter-app

# Canary shares the Production database: use Production's URLs below.
# PostgreSQL: runtime transaction pool and direct migration/admin connection
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_SCHEMA=app
DATABASE_DISPOSABLE=false
MASTRA_DATABASE_SCHEMA=mastra
VECTOR_DATABASE_SCHEMA=vectors

# Redis — set as a Fly runtime secret (do not bake into the image)
REDIS_URL=

# Auth
BETTER_AUTH_SECRET=

# Public URLs (baked into the webapp at image build)
VITE_APP_NAME=M5 Starter
VITE_APP_URL=
VITE_SERVER_URL=
VITE_DOCS_URL=
VITE_ENABLE_WAITLIST=false

# Optional
RESEND_API_KEY=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional PostHog source map uploads (build only; never prefix these with VITE_).
# Use a personal API key with error tracking write access, not the public ingestion key.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
