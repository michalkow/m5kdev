{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "apps/**/locales.ts",
    "apps/**/documentation.ts",
    "apps/locales.ts",
    "apps/documentation.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"],
      "env": [
        "VITE_*",
        "EXPO_PUBLIC_DOCS_URL",
        "POSTHOG_API_KEY",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_HOST"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsconfig.*.json"],
      "outputs": ["tsconfig.tsbuildinfo", "**/*.tsbuildinfo", "dist/tsconfig.lib.tsbuildinfo"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
